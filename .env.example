# Copy to .env and fill in. The .env file is gitignored — never commit it.

# Execution-layer JSON-RPC endpoint (the server reads block + receipt data from here).
EL_RPC_URL=https://your-el-rpc.example
# Bearer token for the endpoint (sent as "Authorization: Bearer <token>"). Leave blank if none.
EL_RPC_TOKEN=

# Optional:
# PORT=8137              # port to serve on (default 8137)
# RPC_VERIFY=true        # set false (or INSECURE=1 env) only if the endpoint uses a self-signed cert

# --- Sepolia (second network, census + dashboard toggle) ------------------------
# The Sepolia census inherits the shared EL_RPC_TOKEN above unless you set a
# Sepolia-specific token here. It defaults to the baked-in endpoint
# (https://sepolia-execution.attestant.io) and runs gently (1 worker, 100ms delay)
# because that dev endpoint is rate-limited. With an unthrottled token, set the
# token AND raise the throughput knobs — the token alone will still run serially.
# SEPOLIA_EL_RPC_URL=        # the unthrottled endpoint. Basic-auth creds can be
#                            # embedded inline: https://USER:PASS@host (the census
#                            # uses requests, which sends them as HTTP Basic auth;
#                            # URL-encode any special chars in the password). Leave
#                            # blank to use the baked-in default.
# SEPOLIA_EL_RPC_TOKEN=      # only for a bearer-token endpoint (not needed if the
#                            # URL above already carries user:pass credentials)
# SEPOLIA_WORKERS=8          # concurrency (default 1 for the throttled endpoint)
# SEPOLIA_SLEEP_MS=0         # ms delay between calls (default 100 when throttled)
