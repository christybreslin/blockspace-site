[Unit]
Description=Blockspace Sepolia census cache catch-up
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Checkout path baked in for the current server. If you relocate the checkout,
# update WorkingDirectory and ExecStart to match.
WorkingDirectory=/root/workspace/eth/blockspace/blockspace-site
EnvironmentFile=/etc/blockspace/env
ExecStart=/root/workspace/eth/blockspace/blockspace-site/deploy/refresh-sepolia.sh
# The Sepolia dev endpoint is heavily rate-limited, so a catch-up run can be slow.
# Disable the start timeout (default ~90s for oneshot) so systemd never kills a
# legitimately long refresh mid-run.
TimeoutStartSec=0
